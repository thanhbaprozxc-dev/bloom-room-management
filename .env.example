SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD
SUPABASE_TIMEOUT_MS=15000
# Optional alias; when set it takes precedence over SUPABASE_TIMEOUT_MS (clamped server-side).
SUPABASE_DB_TIMEOUT_MS=15000
SUPABASE_STORAGE_TIMEOUT_MS=20000

# Optional production diagnostics. Only slow/error metadata is logged by default.
BLOOM_PERF_DEBUG=false
BLOOM_SLOW_QUERY_MS=1000
BLOOM_SLOW_REQUEST_MS=1500

